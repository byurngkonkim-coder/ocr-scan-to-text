# cmd.exe misparses LF-only batch files. Force CRLF on checkout on every PC,
# regardless of that PC's core.autocrlf setting.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# User typo dictionary is edited on two PCs. Keep both sides' added lines on
# merge instead of stopping with a conflict (duplicates collapse on load).
engine/user_typos.tsv merge=union
